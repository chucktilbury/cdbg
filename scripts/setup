#!/usr/bin/env bash

set -euo pipefail

if [[ -n ${_PROJECT_NAME:-} ]]; then
    printf 'A project shell is already active (%s). Exit it before starting another.\n' \
        "$_PROJECT_NAME" >&2
    exit 1
fi

_PROJECT_LOC=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
_PROJECT_NAME=${_PROJECT_LOC##*/}
_BUILD_TYPE=${1:-debug}
if (( $# > 1 )); then
    printf 'Usage: %s [debug|release|profile]\n' "$0" >&2
    exit 2
fi
case "$_BUILD_TYPE" in
    debug) CWHIP_BUILD_TYPE=Debug ;;
    release) CWHIP_BUILD_TYPE=Release ;;
    profile) CWHIP_BUILD_TYPE=RelWithDebInfo ;;
    *)
        printf 'Unknown build type: %s (use debug, release or profile)\n' "$_BUILD_TYPE" >&2
        exit 2
        ;;
esac
export _PROJECT_LOC _PROJECT_NAME _BUILD_TYPE CWHIP_BUILD_TYPE

if [[ -z "${CWHIP_SDK:-}" ]]; then
    config_home="${XDG_CONFIG_HOME:-}"
    if [[ -z "$config_home" && -n "${HOME:-}" ]]; then
        config_home="$HOME/.config"
    fi
    if [[ -n "$config_home" && "$config_home" != /* ]]; then
        printf "Cannot discover sdk_prefix: config home '%s' is not absolute.\n" \
            "$config_home" >&2
        exit 1
    fi
    settings="$config_home/cwhip/settings.toml"
    if [[ -n "$config_home" && -e "$settings" ]]; then
        if ! sdk_prefix="$(python3 "$_PROJECT_LOC/scripts/sdk-prefix.py" "$settings")"; then
            printf 'SDK settings discovery failed; project shell was not started.\n' >&2
            exit 1
        fi
        if [[ -n "$sdk_prefix" ]]; then
            export CWHIP_SDK="$sdk_prefix"
        fi
    fi
fi

mkdir -p -- "$_PROJECT_LOC/build"
cd -- "$_PROJECT_LOC/build"
cmake .. "-DCMAKE_BUILD_TYPE=$CWHIP_BUILD_TYPE"
exec bash --rcfile "$_PROJECT_LOC/.project_env" -i
